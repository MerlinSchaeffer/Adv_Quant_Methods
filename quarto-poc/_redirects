# Redirects from the old Hugo site's URLs to the new Quarto site.
# The old site had per-lecture landing pages (e.g. /lectures/13-rdd/13-rdd/)
# that no longer exist — the new site puts everything on one Lectures page.
# Wildcards send any old bookmark to the right top-level page instead of a 404.

/about/*      /about.html      301
/about        /about.html      301
/exam/*       /exam.html       301
/exam         /exam.html       301
/resources/*  /resources.html  301
/resources    /resources.html  301
/lectures/*   /lectures.html   301
/lectures     /lectures.html   301
